{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "yeda-reader",
	"version": "0.1.0",
	"identifier": "dev.yuvve.yeda.reader",
	"build": {
		"frontendDist": "dist",
		"beforeDevCommand": "npm run build",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [{ "title": "yeda-reader", "width": 1200, "height": 900 }],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "appimage"],
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
	}
}
